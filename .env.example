# Copy to .env (repo root) and adjust. All values are optional; these are the defaults.
# Read by core/config.py for both the FastAPI backend and the Streamlit app.

# Where API responses are cached on disk
CACHE_DIR=./cache
# Refetch cached forecasts after this many seconds (archive and soil data never expire)
FORECAST_TTL_S=10800
# Pause between live SoilGrids calls (fair use is ~5 calls/min)
SOILGRIDS_PAUSE_S=12
# Timeout for a single upstream HTTP request
HTTP_TIMEOUT_S=300
# Comma-separated origins allowed to call the backend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
